# Spurs Pay — environment
NODE_ENV=development
APP_URL=http://127.0.0.1:3100

# Shared Neon Postgres (Spurs Pay uses its own `pay` schema)
DATABASE_SYNC_URL="postgresql://neondb_owner:npg_dOg7JeVM9Kaw@ep-fancy-brook-apiel7gd.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign merchant webhooks + internal tokens
JWT_SECRET="abcdefghijklmnopqrstuvwxyz012345"
WEBHOOK_SIGNING_SECRET="spurs-pay-webhook-signing-secret-change-me"

# Shared secret for private service-to-service calls (must match baas).
# baas Billing calls Spurs Pay's /api/private/* with this; Pay calls baas the same way.
INTERNAL_API_SECRET="123-76-43334-5-433-45-65665-ghfgdfv-s-6543-2v-bvc-vwe-56"

# baas private API base (Pay reads/writes baas data service-to-service if needed)
BAAS_INTERNAL_URL=http://localhost:3000

# Spurs SSO — shared session cookie via @spurs-cloud/accounts.
# No per-app OIDC client any more: accounts issues one cookie for every app.
SPURS_ISSUER=http://127.0.0.1:8000
SPURS_SESSION_SECRET="abcdefghijklmnopqrstuvwxyz012345"

# The underlying payment provider — HIDDEN from customers/merchants.
# sandbox = works with no keys (simulated); flutterwave/paystack = real.
PAY_PROVIDER=sandbox

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
